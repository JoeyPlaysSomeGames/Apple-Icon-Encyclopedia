    UsedFeatures = (UnnamedArguments); 
    Commands = {
		OpenProject = {
			AppleEventClassCode = iDVD;
			AppleEventCode = opFi;
			Arguments = {
						ProjectPath = {AppleEventCode = pJnm; Type = NSString; };
			};
			CommandClass = iDVDScriptCommand;
			ResultAppleEventCode = long;
			Type = "NSNumber<Long>";
		};
		NewProject = {
			AppleEventClassCode = iDVD;
			AppleEventCode = nwPj;
			Arguments = {
						ProjectName = {AppleEventCode = pJnm; Type = NSString; };
						ProjectPath = {AppleEventCode = pJpt; Type = NSString; };
						SaveCurrent = {AppleEventCode = pSct; Type = "NSNumber<Bool>"; };
			};
			CommandClass = iDVDScriptCommand;
			ResultAppleEventCode = long;
			Type = "NSNumber<Long>";
		};
		SaveProject = {
			AppleEventClassCode = iDVD;
			AppleEventCode = svPj;
			Arguments = {
						ProjectPath = {AppleEventCode = pJnm; Type = NSString; Optional = "Yes"; };
			};
			CommandClass = iDVDScriptCommand;
			ResultAppleEventCode = long;
			Type = "NSNumber<Long>";
		};
		ArchiveProject = {
			AppleEventClassCode = iDVD;
			AppleEventCode = arPj;
			Arguments = {
				ProjectPath = {AppleEventCode = arPT; Type = NSString;};
				IncludeThemes = {AppleEventCode = aJIT; Type = "NSNumber<Bool>"; Optional = "Yes"; };
				IncludeEncodedAssets = {AppleEventCode = aJIE; Type = "NSNumber<Bool>"; Optional = "Yes"; };
			};
			CommandClass = iDVDScriptCommand;
			ResultAppleEventCode = long;
			Type = "NSNumber<Long>";
		};
		Quit = {
			AppleEventClassCode = iDVD;
			AppleEventCode = quia;
			CommandClass = iDVDScriptCommand;
			Type = "";
		};
		ShowObjectByName = {
			AppleEventClassCode = iDVD;
			AppleEventCode = sObJ;
			Arguments = {
				ObjectName = {AppleEventCode = oBjN; Type = NSString; };
			};
			CommandClass = iDVDScriptCommand;
			ResultAppleEventCode = long;
			Type = "NSNumber<Long>";
		};
		OpenTray = {
			AppleEventClassCode = iDVD;
			AppleEventCode = opTr;
			Arguments = {
				OfBurner = {AppleEventCode = ofBR; Type = NSString; };
			};
			CommandClass = iDVDScriptCommand;
			ResultAppleEventCode = long;
			Type = "NSNumber<Long>";
		};
		CloseTray = {
			AppleEventClassCode = iDVD;
			AppleEventCode = clTr;
			Arguments = {
				OfBurner = {AppleEventCode = ofBR; Type = NSString; };
				LockDevice = {AppleEventCode = lcDv; Type = "NSNumber<Bool>"; Optional = "Yes"; };				
			};
			CommandClass = iDVDScriptCommand;
			ResultAppleEventCode = long;
			Type = "NSNumber<Long>";
		};
		StartBurn = {
			AppleEventClassCode = iDVD;
			AppleEventCode = stBR;
			Arguments = {
				WithBurner = {AppleEventCode = wiBR; Type = NSString; };			
				EraseRewritable = {AppleEventCode = erRW; Type = "NSNumber<Bool>"; Optional = "Yes"; };
			};			
			CommandClass = iDVDScriptCommand;
			ResultAppleEventCode = long;
			Type = "NSNumber<Long>";
		};
		StartDiscImageBurn = {
			AppleEventClassCode = iDVD;
			AppleEventCode = stDI;
			Arguments = {
				DiscImagePath = {AppleEventCode = diPT; Type = NSString; };
